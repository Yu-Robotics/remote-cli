{
  "name": "@yu_robotics/remote-cli",
  "version": "1.6.236",
  "description": "Remote control Claude Code CLI via mobile",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "remote-cli": "./bin/remote-cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "native/prebuilds",
    "native/managed-worker.cjs"
  ],
  "scripts": {
    "build": "npm run build:native && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/build-release-notes.cjs",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test",
    "build:native": "node scripts/build-native.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yu-Robotics/remote-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Yu-Robotics/remote-cli#readme",
  "bugs": {
    "url": "https://github.com/Yu-Robotics/remote-cli/issues"
  },
  "keywords": [
    "claude",
    "cli",
    "remote",
    "feishu",
    "mobile",
    "claude-code"
  ],
  "author": "xiaoyu",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "axios": "^1.13.5",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "dotenv": "^16.4.1",
    "fs-native-extensions": "1.5.2",
    "node-machine-id": "^1.1.12",
    "ora": "^8.0.1",
    "pdfjs-dist": "4.8.69",
    "sax": "^1.6.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0",
    "markdown-it": "^14.3.2"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "@types/markdown-it": "^14.2.0"
  }
}
